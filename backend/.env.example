# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/worksphere"
# If Postgres reports the database does not exist, run from backend/: npm run db:ensure

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_64_char_hex_string_minimum_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_hex_string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ───────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ─── Mail (SMTP) ───────────────────────────────────────────────────────────────
# Using Gmail: set MAIL_USER to your Gmail address and MAIL_PASS to an App Password
# (Account → Security → 2-Step Verification → App passwords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM_NAME=WorkSphere
MAIL_FROM_ADDRESS=noreply@worksphere.com

# ─── Frontend ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Cloudinary (Dashboard → Settings → API Keys) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
